# Start the SoundWire links from post_fw_run() on ACE 3.0 instead of hda_dsp_probe().
# EXPERIMENTAL - see omnibook-speaker-fix's cmd_sof_order comment and STATE.md 2.4.
# Generated from v7.1.9 sources in ./src/.
--- a/sound/soc/sof/intel/hda.c
+++ b/sound/soc/sof/intel/hda.c
@@ -909,7 +909,18 @@
 	}
 
 	chip = get_chip_info(sdev->pdata);
-	if (chip && chip->hw_ip_version >= SOF_INTEL_ACE_2_0) {
+	/*
+	 * ACE 3.0 (Panther Lake): do NOT bring the SoundWire links up here.
+	 * Peripherals enumerated before the audio DSP firmware boots are knocked
+	 * off the bus in the last few ms of that boot -- measured on an HP
+	 * OmniBook Ultra 14 with four TAS2783: every amplifier reports NPRESENT
+	 * 91.4-93.0 ms before "Booted firmware version", on two boots whose DSP
+	 * boot durations differed by 23 ms, and none of them ever re-attaches.
+	 * Start the links from post_fw_run() instead, which is the ordering every
+	 * pre-ACE-2.0 platform already uses (hda_dsp_post_fw_run(), below).
+	 */
+	if (chip && chip->hw_ip_version >= SOF_INTEL_ACE_2_0 &&
+	    chip->hw_ip_version != SOF_INTEL_ACE_3_0) {
 		ret = hda_sdw_startup(sdev);
 		if (ret < 0) {
 			dev_err(sdev->dev, "could not startup SoundWire links\n");
--- a/sound/soc/sof/intel/ptl.c
+++ b/sound/soc/sof/intel/ptl.c
@@ -85,6 +85,41 @@
 	hdev->mic_privacy.active = true;
 }
 
+/*
+ * ACE 3.0 starts the SoundWire links after the DSP firmware is up, not in
+ * hda_dsp_probe(); see the comment in hda.c. lnl_dsp_post_fw_run() is static in
+ * lnl.c, so chain whatever sof_lnl_set_ops() installed rather than replacing it.
+ */
+static int (*ptl_chained_post_fw_run)(struct snd_sof_dev *sdev);
+
+static int ptl_dsp_post_fw_run(struct snd_sof_dev *sdev)
+{
+	int ret;
+
+	if (sdev->first_boot) {
+		ret = hda_sdw_startup(sdev);
+		if (ret < 0) {
+			/*
+			 * Deliberately NOT fatal. Upstream's equivalent in
+			 * hda_dsp_post_fw_run() aborts the DSP bring-up here,
+			 * which costs the whole card -- HDMI and the headset
+			 * jack included. A SoundWire link that will not start
+			 * leaves those working, so log it and carry on: the
+			 * worst case stays "no SoundWire audio" rather than
+			 * "no audio at all".
+			 */
+			dev_err(sdev->dev,
+				"could not startup SoundWire links: %d (continuing)\n",
+				ret);
+		}
+	}
+
+	if (ptl_chained_post_fw_run)
+		return ptl_chained_post_fw_run(sdev);
+
+	return 0;
+}
+
 int sof_ptl_set_ops(struct snd_sof_dev *sdev, struct snd_sof_dsp_ops *dsp_ops)
 {
 	struct sof_ipc4_fw_data *ipc4_data;
@@ -94,6 +129,10 @@
 	if (ret)
 		return ret;
 
+	/* chain, do not replace: lnl_dsp_post_fw_run() is static in lnl.c */
+	ptl_chained_post_fw_run = dsp_ops->post_fw_run;
+	dsp_ops->post_fw_run = ptl_dsp_post_fw_run;
+
 	ipc4_data = sdev->private;
 	ipc4_data->intel_configure_mic_privacy = sof_ptl_set_mic_privacy;
 
