+/*
+ * A peripheral can fall off the bus after it has been enumerated, e.g. when
+ * the link is reset while the host DSP is brought up. The Cadence IP only
+ * reports *changes* of peripheral status, and the status of every peripheral
+ * is folded into a single interrupt with a logical AND, so a re-attach which
+ * happens while the manager interrupt is masked, or while another status
+ * change is being processed, is never reported again: the peripheral stays
+ * UNATTACHED forever and no rescan is left to notice it.
+ *
+ * The delayed work below is the only rescan of the PING status and it is
+ * scheduled exactly once per bus start. Re-arm it, bounded, while at least
+ * one peripheral which has already been assigned a device number is
+ * UNATTACHED. A peripheral described by firmware but not fitted never gets a
+ * device number, so it never causes a rescan.
+ */
+#define CDNS_ATTACH_RETRY_DELAY_MS	250
+#define CDNS_ATTACH_MAX_RETRIES		20
+
+static bool cdns_peripheral_missing(struct sdw_cdns *cdns)
+{
+	struct sdw_bus *bus = &cdns->bus;
+	struct sdw_slave *slave;
+	bool missing = false;
+
+	mutex_lock(&bus->bus_lock);
+	list_for_each_entry(slave, &bus->slaves, node) {
+		if (slave->dev_num_sticky &&
+		    slave->status == SDW_SLAVE_UNATTACHED) {
+			missing = true;
+			break;
+		}
+	}
+	mutex_unlock(&bus->bus_lock);
+
+	return missing;
+}
+
+static void cdns_arm_attach_check(struct sdw_cdns *cdns)
+{
+	if (cdns->attach_retries >= CDNS_ATTACH_MAX_RETRIES)
+		return;
+
+	cdns->attach_retries++;
+	schedule_delayed_work(&cdns->attach_dwork,
+			      msecs_to_jiffies(CDNS_ATTACH_RETRY_DELAY_MS));
+}
+
